# Django Settings
SECRET_KEY=django-insecure-car-rental-secret-key-2026-production-ready
DEBUG=True
ALLOWED_HOSTS=*

#jwt authentication credenetials
JWT_ACCESS_TOKEN_LIFETIME=60 #(minutes)
JWT_REFRESH_TOKEN_LIFETIME=7 #(days)
JWT_AUTH_HEADER_TYPES = Bearer

# Database: Set DB_ENGINE=postgresql to use PostgreSQL, or leave blank to use SQLite
DB_ENGINE=sqlite3
DB_NAME=car_rental_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Payment Gateways (Optional for live payments; built-in sandbox works out of the box)
RAZORPAY_KEY_ID=rzp_test_mock_12345
RAZORPAY_KEY_SECRET=rzp_test_secret_67890
STRIPE_PUBLISHABLE_KEY=pk_test_mock_12345
STRIPE_SECRET_KEY=sk_test_secret_67890
